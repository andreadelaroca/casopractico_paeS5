<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="900.0" styleClass="main-container" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.casopractico.controller.ClienteConsultaController" onKeyPressed="#handleKeyPressed">

    <!-- Encabezado -->
    <top>
        <VBox spacing="10.0" styleClass="header-area" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Label styleClass="title-label" text="Consulta de Clientes Registrados" />
                <Label styleClass="subtitle-label" text="Haga doble clic sobre un cliente para ver o editar su detalle" />

                <!-- Barra de Búsqueda y Filtros -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="🔍 Buscar por nombre..." />
                        <ComboBox fx:id="cmbFiltroCiudad" prefWidth="180.0" promptText="Filtrar por Ciudad" />
                        <Button fx:id="btnBuscar" onAction="#handleBuscar" styleClass="btn-secondary" text="Buscar" />
                        <Button fx:id="btnLimpiarFiltros" onAction="#handleLimpiarFiltros" styleClass="btn-secondary" text="Limpiar Filtros" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </top>

    <!-- Centro: Tabla de Clientes con evento MouseEvent -->
    <center>
        <VBox styleClass="table-container" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <children>
                <TableView fx:id="tblClientes" onMouseClicked="#handleTablaClick" prefHeight="450.0" prefWidth="860.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombreCompleto" prefWidth="220.0" text="Nombre Completo" />
                        <TableColumn fx:id="colTipoCliente" prefWidth="140.0" text="Tipo de Cliente" />
                        <TableColumn fx:id="colCiudad" prefWidth="140.0" text="Ciudad" />
                        <TableColumn fx:id="colFechaNacimiento" prefWidth="150.0" text="Fecha Nacimiento" />
                        <TableColumn fx:id="colTipoSolicitud" prefWidth="180.0" text="Tipo de Solicitud" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>

    <!-- Barra Inferior de Acciones -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15.0" styleClass="actions-bar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Button fx:id="btnVolver" onAction="#handleVolver" styleClass="btn-secondary" text="Volver al Menú">
                    <graphic>
                        <Label style="-fx-font-size: 14px;" text="⬅ " />
                    </graphic>
                </Button>
                <Button fx:id="btnEditar" onAction="#handleVerDetalle" styleClass="btn-primary" text="Ver Detalle">
                    <graphic>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: white;" text="✏ " />
                    </graphic>
                </Button>
            </children>
        </HBox>
    </bottom>

</BorderPane>