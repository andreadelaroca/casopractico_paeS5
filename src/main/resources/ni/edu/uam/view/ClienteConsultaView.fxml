<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.casopractico.controller.ClienteConsultaController" onKeyPressed="#handleKeyPressed">

    <!-- Encabezado -->
    <top>
        <VBox spacing="10.0" style="-fx-background-color: #F3F4F6; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Label text="Consulta de Clientes Registrados" style="-fx-text-fill: #1F2937; -fx-font-size: 24; -fx-font-weight: bold;" />
                <Label text="Haga doble clic sobre un cliente para ver o editar su detalle" style="-fx-text-fill: #6B7280; -fx-font-size: 12;" />

                <!-- Barra de Búsqueda y Filtros -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="txtBuscar" prefWidth="250.0" promptText="🔍 Buscar por nombre..." style="-fx-font-size: 12; -fx-padding: 8; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-color: #FFFFFF; -fx-text-fill: #1F2937; -fx-prompt-text-fill: #D1D5DB;" />
                        <ComboBox fx:id="cmbFiltroCiudad" prefWidth="180.0" promptText="Filtrar por Ciudad" style="-fx-font-size: 12; -fx-padding: 8; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 4; -fx-background-color: #FFFFFF;" />
                        <Button fx:id="btnBuscar" onAction="#handleBuscar" text="Buscar" style="-fx-padding: 8 16; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-color: #F3F4F6; -fx-text-fill: #1F2937; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 4; -fx-cursor: hand;" />
                        <Button fx:id="btnLimpiarFiltros" onAction="#handleLimpiarFiltros" text="Limpiar Filtros" style="-fx-padding: 8 16; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-color: #F3F4F6; -fx-text-fill: #1F2937; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 4; -fx-cursor: hand;" />
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </top>

    <!-- Centro: Tabla de Clientes con evento MouseEvent -->
    <center>
        <VBox style="-fx-background-color: #FFFFFF;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <children>
                <TableView fx:id="tblClientes" onMouseClicked="#handleTablaClick" prefHeight="450.0" prefWidth="860.0" style="-fx-font-size: 12; -fx-padding: 5;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNombreCompleto" prefWidth="220.0" text="Nombre Completo" />
                        <TableColumn fx:id="colTipoCliente" prefWidth="140.0" text="Tipo de Cliente" />
                        <TableColumn fx:id="colCiudad" prefWidth="140.0" text="Ciudad" />
                        <TableColumn fx:id="colFechaNacimiento" prefWidth="150.0" text="Fecha Nacimiento" />
                        <TableColumn fx:id="colTipoSolicitud" prefWidth="180.0" text="Tipo de Solicitud" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>

    <!-- Barra Inferior de Acciones -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: #F3F4F6; -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Button fx:id="btnVolver" onAction="#handleVolver" text="Volver al Menú" style="-fx-padding: 10 16; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-color: #F3F4F6; -fx-text-fill: #1F2937; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 4; -fx-cursor: hand;">
                    <graphic>
                        <Label style="-fx-font-size: 14;" text="⬅ " />
                    </graphic>
                </Button>
                <Button fx:id="btnEditar" onAction="#handleVerDetalle" text="Ver Detalle" style="-fx-padding: 10 16; -fx-font-size: 12; -fx-font-weight: bold; -fx-background-color: #1E40AF; -fx-text-fill: #FFFFFF; -fx-border-color: #1E40AF; -fx-border-width: 0; -fx-border-radius: 4; -fx-cursor: hand;">
                    <graphic>
                        <Label style="-fx-font-size: 14; -fx-text-fill: white;" text="✏ " />
                    </graphic>
                </Button>
            </children>
        </HBox>
    </bottom>

</BorderPane>