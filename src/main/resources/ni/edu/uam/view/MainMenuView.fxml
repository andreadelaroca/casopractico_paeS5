<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.casopractico.controller.MainMenuController">

    <!-- 1. MenuBar -->
    <top>
        <VBox spacing="0.0" BorderPane.alignment="CENTER">
            <children>
                <MenuBar style="-fx-background-color: #F3F4F6; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;">
                    <menus>
                        <Menu mnemonicParsing="false" text="Archivo">
                            <items>
                                <MenuItem fx:id="menuCerrarSesion" mnemonicParsing="false" onAction="#handleCerrarSesion" text="Cerrar Sesión" />
                                <SeparatorMenuItem mnemonicParsing="false" />
                                <MenuItem fx:id="menuSalir" mnemonicParsing="false" onAction="#handleSalir" text="Salir" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Gestión">
                            <items>
                                <MenuItem fx:id="menuRegistrarCliente" mnemonicParsing="false" onAction="#handleNavRegistro" text="Registrar Cliente" />
                                <MenuItem fx:id="menuConsultarClientes" mnemonicParsing="false" onAction="#handleNavConsulta" text="Consultar Clientes" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Ayuda">
                            <items>
                                <MenuItem fx:id="menuAcercaDe" mnemonicParsing="false" onAction="#handleAcercaDe" text="Acerca de" />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>

                <!-- 2. ToolBar -->
                <ToolBar style="-fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0; -fx-padding: 8 10;">
                    <items>
                        <Button fx:id="btnTbRegistro" onAction="#handleNavRegistro" text="➕ Nuevo Cliente" style="-fx-padding: 8 12; -fx-font-size: 12; -fx-background-color: #1E40AF; -fx-text-fill: #FFFFFF; -fx-border-radius: 4; -fx-cursor: hand;" />
                        <Button fx:id="btnTbConsulta" onAction="#handleNavConsulta" text="🔍 Consultar Clientes" style="-fx-padding: 8 12; -fx-font-size: 12; -fx-background-color: #1E40AF; -fx-text-fill: #FFFFFF; -fx-border-radius: 4; -fx-cursor: hand;" />
                    </items>
                </ToolBar>
            </children>
        </VBox>
    </top>

    <!-- 3. Contenido Central -->
    <center>
        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #F3F4F6;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo.png" />
                    </image>
                </ImageView>

                <Label text="Sistema de Gestión de Solicitudes" style="-fx-text-fill: #1F2937; -fx-font-size: 24; -fx-font-weight: bold;" />
                <Label text="Seleccione una opción para comenzar" style="-fx-text-fill: #6B7280; -fx-font-size: 14;" />

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <!-- Botón Registrar Cliente -->
                        <Button fx:id="btnCardRegistro" alignment="CENTER" contentDisplay="TOP" onAction="#handleNavRegistro" prefHeight="110.0" prefWidth="170.0" text="Registrar Cliente" style="-fx-padding: 15; -fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #1F2937; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);">
                            <graphic>
                                <Label text="➕" style="-fx-font-size: 26; -fx-text-fill: #2c3e50;" />
                            </graphic>
                        </Button>

                        <!-- Botón Consultar Clientes -->
                        <Button fx:id="btnCardConsulta" alignment="CENTER" contentDisplay="TOP" onAction="#handleNavConsulta" prefHeight="110.0" prefWidth="170.0" text="Consultar Clientes" style="-fx-padding: 15; -fx-background-color: #FFFFFF; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 6; -fx-text-fill: #1F2937; -fx-font-size: 13; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 4, 0, 0, 1);">
                            <graphic>
                                <Label text="📋" style="-fx-font-size: 26; -fx-text-fill: #2c3e50;" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

    <!-- 4. ContextMenu integrado correctamente dentro de un control (Label de Estado) -->
    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #1E293B; -fx-border-color: #0F172A; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
            <children>
                <Label fx:id="lblEstado" text="Estado: Sesión activa" style="-fx-text-fill: #FFFFFF; -fx-font-size: 11;">
                    <contextMenu>
                        <ContextMenu>
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#handleAcercaDe" text="Acerca del Sistema" />
                                <MenuItem mnemonicParsing="false" onAction="#handleCerrarSesion" text="Cerrar Sesión" />
                            </items>
                        </ContextMenu>
                    </contextMenu>
                </Label>
            </children>
        </HBox>
    </bottom>

</BorderPane>